# Copy to .env and fill in (Supabase > Project Settings > API). Leave empty to run offline-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STORE_ID=bar-main

# Branding. The product name is MjTech Point Of Sale (src/brand.ts). Optional overrides:
# VITE_BRAND_PRODUCT=MjTech Point Of Sale
# VITE_BRAND_LEAD=MjTech
# VITE_BRAND_TAIL= POS
# VITE_BRAND_TAGLINE=Bar & Wholesale Suite
# The CLIENT's business name is NOT set here: the owner types it in the app (sidebar > Business details).

# Owner password recovery code (works offline). Change it for each venue.
VITE_OWNER_RECOVERY_CODE=2026DC
